{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!**/node_modules/**/*",
      "!**/playwright-report/**/*",
      "!**/.medusa/**/*",
      "!**/migrations/**/*",
      "!**/.next/**/*",
      "!apps/payload/src/payload-types.ts",
      "!apps/payload/src/app/(payload)/importMap.js",
      "!**/check-env-variables.js",
      "!**/*.stories.tsx",
      "!**/.storybook/main.ts",
      "!apps/medusa-be/tests/fixtures/ro-catalog-source-extract/befungin-minimal.html",
      "!**/libs/ui/src/tokens/index.css"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "off",
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedProperties": "off",
        "useSortedSelectionSet": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noIncrementDecrement": {
          "level": "error",
          "options": {
            "allowForLoopAfterthoughts": true
          }
        },
        "useConsistentMethodSignatures": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDestructuring": "off",
        "useErrorCause": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "info",
        "useTopLevelRegex": "info"
      },
      "suspicious": {
        "noEqualsToNull": "off",
        "noEmptyBlockStatements": "info",
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn",
        "noEvolvingTypes": "warn",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": ["libs/ui/**/*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noLeakedRender": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts"],
      "javascript": {
        "globals": ["jest", "describe", "it", "expect", "beforeEach"]
      }
    },
    {
      "includes": ["libs/analytics/src/**/*"],
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn",
            "useSimplifiedLogicExpression": "warn"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": "warn",
            "useUnifiedTypeSignatures": "warn"
          }
        }
      }
    },
    {
      "includes": ["libs/analytics/src/**/*.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/medusa-be/**/*"],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn"
          },
          "performance": {
            "noBarrelFile": "off",
            "noNamespaceImport": "info"
          }
        }
      }
    }
  ]
}
