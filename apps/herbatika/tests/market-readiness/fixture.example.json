{
  "schemaVersion": 1,
  "xDefaultMarket": "sk",
  "proofRequirements": [
    {
      "name": "catalog",
      "kind": "herbatika-four-market-catalog-live-readiness",
      "schemaVersion": 1,
      "assertions": [
        { "path": ["scope"], "equals": "four-market-catalog-readiness" }
      ]
    },
    {
      "name": "commerce",
      "kind": "four-market-commerce-collection",
      "schemaVersion": 1,
      "assertions": [{ "path": ["ready"], "equals": true }]
    },
    {
      "name": "urlRegistry",
      "kind": "herbatika-four-market-urlr-convergence",
      "schemaVersion": 1,
      "assertions": [{ "path": ["state"], "equals": "converged" }]
    },
    {
      "name": "staticTaxonomy",
      "kind": "herbatika-four-market-static-taxonomy-convergence",
      "schemaVersion": 1,
      "assertions": [{ "path": ["state"], "equals": "converged" }]
    },
    {
      "name": "meilisearch",
      "kind": "herbatika-four-market-meilisearch-convergence-proof",
      "schemaVersion": 1,
      "assertions": [{ "path": ["aggregate", "state"], "equals": "converged" }]
    },
    {
      "name": "hostname",
      "kind": "herbatika-four-market-hostname-readiness",
      "schemaVersion": 1,
      "assertions": [
        { "path": ["ready"], "equals": true },
        { "path": ["issues"], "equals": [] }
      ]
    }
  ],
  "markets": {
    "sk": {
      "locale": "sk-SK",
      "htmlLang": "sk-SK",
      "currencyCode": "EUR",
      "forbiddenCurrencyCodes": ["CZK", "HUF", "RON"],
      "currencyPathPrefixes": ["/REPLACE_SK_PRODUCT_PREFIX/"],
      "requiredPages": [
        {
          "approvalBinding": null,
          "kind": "catalog",
          "path": "/REPLACE_SK_CATALOG_PATH",
          "requiredText": ["REPLACE_SK_CATALOG_TEXT"]
        },
        {
          "approvalBinding": {
            "contentKind": "about",
            "entryId": "about",
            "routeKey": "root:about"
          },
          "kind": "static",
          "path": "/REPLACE_SK_STATIC_PATH",
          "requiredText": ["REPLACE_SK_STATIC_TEXT"]
        },
        {
          "approvalBinding": {
            "contentKind": "cms-legal",
            "entryId": "terms",
            "routeKey": "root:terms"
          },
          "kind": "legal",
          "path": "/REPLACE_SK_LEGAL_PATH",
          "requiredText": ["REPLACE_SK_LEGAL_TEXT"]
        }
      ]
    },
    "cz": {
