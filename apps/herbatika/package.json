{
  "name": "herbatika",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "start:ci-dev": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "pnpm verify:next-version && next build --turbopack && pnpm build:url-registry-tools && pnpm verify:next-build",
    "start": "next start",
    "migrate:url-registry": "node scripts/url-registry/migrate.mjs",
    "populate:url-registry": "tsx scripts/url-registry/populate.ts",
    "test": "vitest run",
    "test:m00:wire": "node tests/wire/m00/run-compose.mjs",
    "test:m00:wire:target": "node --test tests/wire/m00-pages-status.mjs",
    "test:url-architecture:matrix": "node --test tests/url-architecture/matrix.node-test.mjs tests/url-architecture/helpers.node-test.mjs",
    "test:url-architecture:wire": "node --test tests/url-architecture/release-wire.node-test.mjs tests/url-architecture/release-browser.node-test.mjs",
    "test:url-architecture:release": "node tests/url-architecture/run-release.mjs",
    "test:next-build": "node --test scripts/assert-next-build.node-test.mjs",
    "test:next-version": "node --test scripts/assert-next-version.node-test.mjs",
    "test:url-registry:migrations": "node --test scripts/url-registry/migrate.node-test.mjs scripts/url-registry/migration-files.node-test.mjs scripts/url-registry/migration-plan.node-test.mjs scripts/url-registry/migration-runner.node-test.mjs scripts/url-registry/verify-latest-migration.node-test.mjs",
    "test:url-registry:pg18": "node tests/url-registry/run-pg18-gate.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "validate:token-usage": "node scripts/validate-token-usage.mjs",
    "validate:token-usage:json": "node scripts/validate-token-usage.mjs --json",
    "validate:ui-primitives": "node scripts/validate-ui-primitives.mjs",
    "validate:ui-primitives:json": "node scripts/validate-ui-primitives.mjs --json",
    "validate:file-size": "node scripts/validate-file-size-guardrail.mjs",
    "validate:file-size:json": "node scripts/validate-file-size-guardrail.mjs --json",
    "validate:guardrails": "pnpm validate:token-usage && pnpm validate:ui-primitives && pnpm validate:file-size",
    "verify:next-build": "node scripts/assert-next-build.mjs",
    "verify:next-version": "node scripts/assert-next-version.mjs",
    "build:url-registry-tools": "mkdir -p .next/standalone/apps/herbatika/scripts/url-registry .next/standalone/apps/herbatika/src/lib/url-registry/migrations && esbuild scripts/url-registry/populate.ts --bundle --platform=node --format=esm --target=node24 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=.next/standalone/apps/herbatika/scripts/url-registry/populate.mjs && cp scripts/url-registry/migrate.mjs scripts/url-registry/migration-files.mjs scripts/url-registry/migration-ledger.mjs scripts/url-registry/migration-plan.mjs scripts/url-registry/migration-runner.mjs .next/standalone/apps/herbatika/scripts/url-registry/ && cp src/lib/url-registry/migrations/*.sql .next/standalone/apps/herbatika/src/lib/url-registry/migrations/"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:web",
      "framework:next"
    ]
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.18.0",
    "@medusajs/types": "^2.18.0",
    "@tanstack/react-form": "^1.27.4",
    "@tanstack/react-query": "^5.90.2",
    "@techsio/storefront-data": "workspace:*",
    "@techsio/storefront-i18n": "workspace:*",
    "@techsio/ui-kit": "workspace:*",
    "next": "16.3.0-preview.5",
    "next-intl": "^4.13.2",
    "nuqs": "^2.8.8",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@iconify/tailwind4": "^1.0.6",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.12.4",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vite": "catalog:vite8-testing",
    "vitest": "catalog:vite8-testing"
  }
}
