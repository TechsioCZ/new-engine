{
  "name": "herbatika",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "start:ci-dev": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "validate:token-usage": "node scripts/validate-token-usage.mjs",
    "validate:token-usage:json": "node scripts/validate-token-usage.mjs --json",
    "validate:ui-primitives": "node scripts/validate-ui-primitives.mjs",
    "validate:ui-primitives:json": "node scripts/validate-ui-primitives.mjs --json",
    "validate:file-size": "node scripts/validate-file-size-guardrail.mjs",
    "validate:file-size:json": "node scripts/validate-file-size-guardrail.mjs --json",
    "validate:guardrails": "pnpm validate:token-usage && pnpm validate:ui-primitives && pnpm validate:file-size && pnpm validate:url-segments",
    "validate:url-segments": "vitest run scripts/validate-url-segments.test.ts",
    "url-registry:migrate": "node scripts/url-registry-migrate.mjs",
    "url-registry:seed": "node scripts/url-registry-seed.mjs"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:web",
      "framework:next"
    ]
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.18.0",
    "@medusajs/types": "^2.18.0",
    "@tanstack/react-form": "^1.27.4",
    "@tanstack/react-query": "^5.90.2",
    "@techsio/storefront-data": "workspace:*",
    "@techsio/storefront-i18n": "workspace:*",
    "@techsio/ui-kit": "workspace:*",
    "next": "16.3.0-preview.5",
    "next-intl": "^4.13.2",
    "nuqs": "^2.8.8",
    "pg": "^8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@iconify/tailwind4": "^1.0.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.12.4",
    "@types/pg": "^8.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "catalog:vite8-testing",
    "vitest": "catalog:vite8-testing"
  }
}
