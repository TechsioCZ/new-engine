{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.web-revolution.cz/schemas/ro-catalog-import-v1.json",
  "title": "Herbatica Romanian catalog import manifest",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "categories": ["categoryInventory"],
    "categoryInventory": ["categories"]
  },
  "required": [
    "schemaVersion",
    "market",
    "locale",
    "postCommerceInventoryEvidence",
    "readiness",
    "products",
    "brandInventory",
    "brands",
    "collectionInventory"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "market": { "const": "ro" },
    "locale": { "const": "ro-RO" },
    "omissionMode": { "const": "official-ro-description-only" },
    "postCommerceInventoryEvidence": {
      "$ref": "#/$defs/postCommerceInventoryEvidence"
    },
    "readiness": { "$ref": "#/$defs/readiness" },
    "brandInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": { "count": { "type": "integer", "minimum": 0 } }
    },
    "brands": {
      "type": "array",
      "items": { "$ref": "#/$defs/brand" }
    },
    "excludedBrands": {
      "type": "array",
      "items": { "$ref": "#/$defs/excludedBrand" }
    },
    "collectionInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": { "count": { "const": 0 } }
    },
    "categoryInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeCount", "rootCount"],
      "properties": {
        "activeCount": { "type": "integer", "minimum": 0 },
        "rootCount": { "type": "integer", "minimum": 0 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "excludedCategories": {
      "type": "array",
      "items": { "$ref": "#/$defs/excludedCategory" }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    },
    "excludedProducts": {
      "type": "array",
      "items": { "$ref": "#/$defs/excludedProduct" }
    }
  },
  "$defs": {
    "stateFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sha256"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "skStateProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "errors", "sha256"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "maxItems": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "postCommerceInventoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "commerceApplyReceiptSha256",
        "commercePlanFileSha256",
        "commercePlanHash",
        "commerceRestoreArtifactSha256",
        "environment",
        "kind",
        "observedCommerceSnapshotSha256",
        "payloadSha256",
        "postCommerceEnvelopeSha256",
        "postCommerceSharedInventoryFingerprint",
        "postCommerceSkBaseline",
        "preCommerceSharedInventoryFingerprint",
        "preCommerceSkBaseline",
        "priceAuthoritySha256",
        "rawLiveInventorySha256",
        "schemaVersion",
        "sourceInventoryEnvelopeSha256"
      ],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "commerceApplyReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commercePlanFileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commercePlanHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "commerceRestoreArtifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backendBuildHash",
            "backendDeploymentId",
            "backendReleaseSha",
            "backendSlot",
            "databaseFingerprint",
            "environmentId",
            "locale",
            "marketCode",
            "salesChannelId"
          ],
          "properties": {
            "backendBuildHash": { "type": "string", "minLength": 1 },
            "backendDeploymentId": { "type": "string", "minLength": 1 },
            "backendReleaseSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "backendSlot": { "enum": ["blue", "green"] },
            "databaseFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environmentId": { "type": "string", "minLength": 1 },
            "locale": { "const": "ro-RO" },
            "marketCode": { "const": "ro" },
            "salesChannelId": { "type": "string", "minLength": 1 }
          }
        },
        "kind": { "const": "ro-demo-post-commerce-envelope" },
        "observedCommerceSnapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "postCommerceEnvelopeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "postCommerceSharedInventoryFingerprint": {
          "$ref": "#/$defs/stateFingerprint"
        },
        "postCommerceSkBaseline": { "$ref": "#/$defs/skStateProof" },
        "preCommerceSharedInventoryFingerprint": {
          "$ref": "#/$defs/stateFingerprint"
        },
        "preCommerceSkBaseline": { "$ref": "#/$defs/skStateProof" },
        "priceAuthoritySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rawLiveInventorySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaVersion": { "const": 1 },
        "sourceInventoryEnvelopeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "excludedBrand": {
      "allOf": [
        { "$ref": "#/$defs/excludedProduct" },
        {
          "properties": {
            "key": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "medusa_id" },
                "value": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "publicationStatus",
        "publicSlug",
        "salesChannelId",
        "source",
        "translation"
      ],
      "properties": {
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "medusa_id" },
            "value": { "$ref": "#/$defs/identifier" }
          }
        },
        "publicationStatus": { "const": "published" },
        "publicSlug": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "salesChannelId": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/sourceEvidence" },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": { "title": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[!-~]+$"
    },
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "retrievedAt", "contentSha256"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://([^/]+\\.)?herbatica\\.ro/"
        },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "categoryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["medusa_id", "source_category_id", "source_guid"] },
        "value": { "$ref": "#/$defs/identifier" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedDirectChildCount",
        "expectedDirectProductCount",
        "key",
        "parentKey",
        "publicSlug",
        "publicationStatus",
        "salesChannelId",
        "source",
        "translation"
      ],
      "properties": {
        "expectedDirectChildCount": { "type": "integer", "minimum": 0 },
        "expectedDirectProductCount": { "type": "integer", "minimum": 0 },
        "key": { "$ref": "#/$defs/categoryKey" },
        "parentKey": {
          "oneOf": [{ "$ref": "#/$defs/categoryKey" }, { "type": "null" }]
        },
        "publicSlug": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "publicationStatus": { "enum": ["draft", "published"] },
        "salesChannelId": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/sourceEvidence" },
        "translation": { "$ref": "#/$defs/categoryTranslation" }
      }
    },
    "categoryTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "top_description_html",
        "bottom_description_html",
        "meta_title",
        "meta_description"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"], "minLength": 1 },
        "top_description_html": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "bottom_description_html": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "meta_title": { "type": ["string", "null"], "minLength": 1 },
        "meta_description": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "currencyCode",
        "shippingOptionIds",
        "taxRegionIds",
        "paymentProviderIds"
      ],
      "properties": {
        "regionId": { "$ref": "#/$defs/identifier" },
        "currencyCode": { "const": "ron" },
        "shippingOptionIds": { "$ref": "#/$defs/identifierList" },
        "taxRegionIds": { "$ref": "#/$defs/identifierList" },
        "paymentProviderIds": { "$ref": "#/$defs/identifierList" }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["sku", "ean", "external_id", "medusa_id"] },
        "value": { "$ref": "#/$defs/identifier" }
      }
    },
    "variantKey": {
      "allOf": [
        { "$ref": "#/$defs/key" },
        { "properties": { "kind": { "enum": ["sku", "ean"] } } }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "roAvailability"],
      "properties": {
        "key": { "$ref": "#/$defs/variantKey" },
        "roAvailability": { "enum": ["sellable", "unavailable"] },
        "ronPrice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currencyCode", "amount", "approval"],
          "properties": {
            "currencyCode": { "const": "ron" },
            "amount": { "type": "integer", "minimum": 0 },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["approvedAt", "approvedBy", "reference"],
              "properties": {
                "approvedAt": { "type": "string", "format": "date-time" },
                "approvedBy": { "type": "string", "minLength": 1 },
                "reference": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "source",
        "translation",
        "productContent",
        "publicSlug",
        "publicationStatus",
        "variants"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "source": { "$ref": "#/$defs/sourceEvidence" },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "subtitle": { "type": ["string", "null"] }
          }
        },
        "productContent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usage", "composition", "warning", "other"],
          "properties": {
            "usage": { "type": "string" },
            "composition": { "type": "string" },
            "warning": { "type": "string" },
            "other": { "type": "string" }
          }
        },
        "publicSlug": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "publicationStatus": { "enum": ["draft", "published"] },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "excludedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "key", "reason", "source"],
      "properties": {
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvedAt", "approvedBy", "reference"],
          "properties": {
            "approvedAt": { "type": "string", "format": "date-time" },
            "approvedBy": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        "key": { "$ref": "#/$defs/key" },
        "reason": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/sourceEvidence" }
      }
    },
    "excludedCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "key", "reason", "source", "translation"],
      "properties": {
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvedAt", "approvedBy", "reference"],
          "properties": {
            "approvedAt": { "type": "string", "format": "date-time" },
            "approvedBy": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        "key": { "$ref": "#/$defs/categoryKey" },
        "reason": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/sourceEvidence" },
        "translation": { "$ref": "#/$defs/categoryTranslation" }
      }
    }
  }
}
