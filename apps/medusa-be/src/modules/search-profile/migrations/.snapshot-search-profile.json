          "expression": "last_sync_status in ('never', 'running', 'succeeded', 'failed')",
          "definition": "check ((last_sync_status = any (array['never'::text, 'running'::text, 'succeeded'::text, 'failed'::text])))"
        },
        {
          "name": "search_profile_sync_mode_check",
          "expression": "last_sync_mode is null or last_sync_mode in ('normal', 'full')",
