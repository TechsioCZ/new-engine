      "checks": [
        {
          "name": "search_profile_availability_check",
          "expression": "availability in ('all', 'in-stock')",
          "definition": "check ((availability = any (array['all'::text, 'in-stock'::text])))"
        },
        {
          "name": "search_profile_minimum_ranking_score_check",
          "expression": "minimum_ranking_score is null or (minimum_ranking_score >= 0 and minimum_ranking_score <= 1)",
          "definition": "check (((minimum_ranking_score is null) or ((minimum_ranking_score >= (0)::double precision) and (minimum_ranking_score <= (1)::double precision))))"
        },
        {
