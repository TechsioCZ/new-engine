{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "paths": {
    "@libs/ui": ["./libs/ui/src"],
    "@libs/ui/*": ["./libs/ui/src/*"],
    "@libs/analytics": ["./libs/analytics/src"],
    "@libs/analytics/*": ["./libs/analytics/src/*"]
  },
  "ignoreBinaries": ["build", "semantic-release"],
  "ignoreDependencies": ["@iconify/json", "@iconify/tailwind4", "tslib"],
  "ignoreUnresolved": ["^\\.\\./\\*\\*/\\*\\.\\{js,ts,jsx,tsx,mdx\\}$"],
  "ignore": [
    "**/dist/**",
    "**/.next/**",
    "**/build/**",
    "**/storybook-static/**",
    "**/coverage/**",
    "**/.netlify/**",
    "**/e2e/**",
    "**/playwright-report/**",
    "**/*.generated.{ts,tsx}",
    "**/.cache/**",
    "**/local/**",
    "reports/**"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreIssues": {
    "**/*.stories.tsx": ["exports"],
    "**/*.stories.ts": ["exports"],
    "**/tokens/**/*.ts": ["exports", "types"],
    "**/tokens/**/*.css": ["files"]
  },
  "workspaces": {
    "libs/ui": {
      "entry": [
        "src/atoms/*.tsx!",
        "src/molecules/*.tsx!",
        "src/organisms/*.tsx!",
        "src/templates/*.tsx!",
        "src/theme/*.{ts,tsx}!",
        "src/types/*.ts!",
        "src/utils.ts!",
        "release.config.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "stories/**/*.{ts,tsx,mdx}",
        ".storybook/**/*.{ts,tsx}"
      ],
      "storybook": {
        "config": [".storybook/main.ts"],
        "entry": ["**/*.stories.{ts,tsx}", ".storybook/**/*.{ts,tsx}"]
      },
      "ignoreDependencies": ["^@iconify-json/", "^@semantic-release/"],
      "ignore": ["storybook-static/**", "local/**"]
    },
    "libs/analytics": {
      "entry": [
        "src/index.ts!",
        "src/core/index.ts!",
        "src/meta/index.ts!",
        "src/google/index.ts!",
        "src/heureka/index.ts!",
        "src/leadhub/index.ts!"
      ],
      "ignoreDependencies": ["@types/react-dom"]
    }
  },
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
