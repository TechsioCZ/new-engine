{
  "name": "@new-wr/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "create-app": "node scripts/create-app.mts",
    "lint:nx": "NX_DAEMON=false nubx --node nx show projects > /dev/null && eslint --config eslint.nx.config.cjs \"libs/**/*.{ts,tsx,js,jsx}\"",
    "nx:affected": "NX_DAEMON=false nubx --node nx affected -t lint test",
    "knip": "knip",
    "knip:report": "knip --reporter markdown > reports/knip-report.md",
    "knip:fix": "knip --fix",
    "knip:prod": "knip --production",
    "jscpd": "jscpd libs/",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execSync('lefthook install', { stdio: 'inherit' })\""
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@nubjs/nub": "0.9.6",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@playwright/test": "^1.64.0",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.13",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "nx": "23.3.0",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.4"
  },
  "packageManager": "pnpm@12.11.2"
}
