  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "pnpm -w exec biome lint libs/storefront-data/src --diagnostic-level=error",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.type-tests.json",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:release": "pnpm typecheck && pnpm test && pnpm build && pnpm validate:package"
  },
  "nx": {
    "tags": [
      "type:lib",
      "platform:web",
      "framework:react"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "workspaceTooling"
        ],
        "outputs": [],
        "options": {
          "command": "pnpm test",
          "cwd": "libs/storefront-data"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "workspaceTooling"
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/tsconfig.type-tests.tsbuildinfo"
        ],
        "options": {
          "command": "pnpm typecheck",
          "cwd": "libs/storefront-data"
        }
      }
    }
  },
