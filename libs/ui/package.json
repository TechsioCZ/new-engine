{
  "name": "@techsio/ui-kit",
  "version": "0.3.2",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechsioCZ/new-engine.git",
    "directory": "libs/ui"
  },
  "exports": {
    "./hotkeys": {
      "types": "./dist/src/hotkeys.d.ts",
      "import": "./dist/hotkeys.js"
    },
    "./types/zag": {
      "types": "./dist/src/types/zag.d.ts",
      "import": "./dist/types/zag.js"
    },
    "./tokens": {
      "types": "./src/tokens/styles.d.ts",
      "style": "./src/tokens/tokens-only.css",
      "default": "./src/tokens/tokens-only.css"
    },
    "./tokens-with-tailwind": {
      "types": "./src/tokens/styles.d.ts",
      "style": "./src/tokens/index.css",
      "default": "./src/tokens/index.css"
    },
    "./theme.css": {
      "types": "./src/tokens/styles.d.ts",
      "style": "./src/tokens/theme.css",
      "default": "./src/tokens/theme.css"
    },
    "./tokens/*": {
      "types": "./src/tokens/styles.d.ts",
      "style": "./src/tokens/*.css",
      "default": "./src/tokens/*.css"
    },
    "./atoms/*": {
      "types": "./dist/src/atoms/*.d.ts",
      "import": "./dist/atoms/*.js"
    },
    "./molecules/*": {
      "types": "./dist/src/molecules/*.d.ts",
      "import": "./dist/molecules/*.js"
    },
    "./organisms/*": {
      "types": "./dist/src/organisms/*.d.ts",
      "import": "./dist/organisms/*.js"
    },
    "./templates/*": {
      "types": "./dist/src/templates/*.d.ts",
      "import": "./dist/templates/*.js"
    },
    "./theme/*": {
      "types": "./dist/src/theme/*.d.ts",
      "import": "./dist/theme/*.js"
    },
    "./utils": {
      "types": "./dist/src/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "src/tokens"
  ],
  "scripts": {
    "build": "rslib build",
    "check:package": "cross-env RSLIB_CHECK_OUTPUT=true rslib build && node scripts/validate-package-exports.mjs",
    "build:storybook": "storybook build",
    "dev": "rslib build --watch",
    "storybook": "storybook dev",
    "figma:connect:parse": "figma connect parse --config figma.config.json",
    "figma:connect:publish": "figma connect publish --config figma.config.json",
    "test": "vitest run --config vitest.config.ts",
    "test-storybook": "test-storybook --index-json",
    "storybook:a11y": "bash scripts/storybook-a11y.sh",
    "test:visual-assets": "node --test test/visual-assets.test.mjs",
    "test:components": "node scripts/run-component-tests.mjs",
    "test:components:update": "node scripts/run-component-tests.mjs --update-snapshots",
    "test:sidebar:ssr": "bun test ./test/sidebar.ssr.bun.tsx",
    "lint:tailwind": "eslint \"**/*.{js,jsx,ts,tsx}\" --config eslint.config.js",
    "lint:tailwind:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --config eslint.config.js --fix",
    "prepare": "node -e \"if (!process.env.RSLIB_CHECK_OUTPUT) require('node:child_process').execSync('pnpm build', { stdio: 'inherit' })\"",
    "check:unused-tokens": "node scripts/check-unused-tokens.js",
    "validate:tokens": "node scripts/validate-token-usage.js && node scripts/validate-token-definitions.js",
    "validate:token-usage": "node scripts/validate-token-usage.js",
    "validate:token-definitions": "node scripts/validate-token-definitions.js",
    "semantic-release": "semantic-release",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mdi-light": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@tanstack/charts": "^1.0.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@zag-js/accordion": "^1.45.0",
    "@zag-js/carousel": "^1.45.0",
    "@zag-js/cascade-select": "^1.45.0",
    "@zag-js/checkbox": "^1.45.0",
    "@zag-js/collapsible": "^1.45.0",
    "@zag-js/combobox": "^1.45.0",
    "@zag-js/date-input": "^1.45.0",
    "@zag-js/date-picker": "^1.45.0",
    "@zag-js/dialog": "^1.45.0",
    "@zag-js/drawer": "^1.45.0",
    "@zag-js/file-upload": "^1.45.0",
    "@zag-js/hotkeys": "^1.45.0",
    "@zag-js/i18n-utils": "^1.45.0",
    "@zag-js/menu": "^1.45.0",
    "@zag-js/number-input": "^1.45.0",
    "@zag-js/pagination": "^1.45.0",
    "@zag-js/popover": "^1.45.0",
    "@zag-js/presence": "^1.45.0",
    "@zag-js/radio-group": "^1.45.0",
    "@zag-js/rating-group": "^1.45.0",
    "@zag-js/react": "^1.45.0",
    "@zag-js/select": "^1.45.0",
    "@zag-js/slider": "^1.45.0",
    "@zag-js/steps": "^1.45.0",
    "@zag-js/switch": "^1.45.0",
    "@zag-js/tabs": "^1.45.0",
    "@zag-js/toast": "^1.45.0",
    "@zag-js/tooltip": "^1.45.0",
    "@zag-js/tour": "^1.45.0",
    "@zag-js/tree-view": "^1.45.0",
    "better-themes": "^1.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "libphonenumber-js": "^1.13.14",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.1",
    "@iconify-json/cif": "^1.2.7",
    "@iconify-json/twemoji": "^1.2.5",
    "@rsbuild/core": "2.2.11",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@techsio/storybook-a11y-reporter": "0.1.3",
    "@techsio/storybook-better-a11y": "0.1.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rsbuild-plugin-arethetypeswrong": "0.4.0",
    "rsbuild-plugin-publint": "^1.0.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.1",
    "storybook-addon-rslib": "^3.6.0",
    "storybook-react-rsbuild": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.0",
    "@types/react-dom": ">=19.2.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
