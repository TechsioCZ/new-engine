{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/install-git-hook.mjs\""
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash|shell|local_shell",
        "command": "node \"${PLUGIN_ROOT}/scripts/pre-push-validate-gate.mjs\""
      }
    ]
  }
}
